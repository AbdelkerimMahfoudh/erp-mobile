{
  "expo": {
    "name": "Retail ERP",
    "slug": "phonestore-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "retailerp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mr.retailerp.app"
    },
    "android": {
      "package": "mr.retailerp.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4f46e5"
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Retail ERP uses the camera to scan IMEIs, serial numbers and barcodes so you do not have to type them.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "834d8b25-2737-46e8-b911-3eac6d85c2fb"
      }
    }
  }
}
