# Mobile staging configuration — NAMES ONLY.
#
# Copy to `.env.staging` (git-ignored) and fill in the staging host.
#
# Everything prefixed EXPO_PUBLIC_ is INLINED INTO THE BUNDLE and readable by
# anybody who has the app. Only public configuration may appear here:
# never a database credential, never an administrator password, never a server
# secret.

# The staging host. One hostname serves the website and the API, so the app
# talks to the same origin the browser does.
#   EXPO_PUBLIC_API_HOST=192.168.100.3
EXPO_PUBLIC_API_HOST=

# Where the four legal pages open in the phone's browser (privacy, terms, support, account deletion — their
# `/in-app/` addresses): an HTTPS origin only. The app opens no other page of any website: the business account is
# created in the app, and the subscription and the free trial live on the Dukan ERP portal, which the app never names.
#   EXPO_PUBLIC_LEGAL_ORIGIN=https://<staging-host>
EXPO_PUBLIC_LEGAL_ORIGIN=

# Shown in the app so a tester can never mistake a staging build for the real
# thing. Leave unset for production builds.
EXPO_PUBLIC_APP_ENV=staging
