{
  "expo": {
    "name": "Dukan ERP",
    "slug": "dukan-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dukanerp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mr.tsxmr.dukanerp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mr.tsxmr.dukanerp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#5146D9"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F1F3F8",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0B0F17"
          }
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukan ERP uses the camera to scan IMEIs, serial numbers and barcodes so you do not have to type them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dukan ERP opens your photos only when you choose a receipt picture for an expense.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86a08e0d-578d-479f-986d-51706ea99522"
      }
    },
    "locales": {
      "fr": "./locales/fr.json",
      "ar": "./locales/ar.json"
    },
    "icon": "./assets/images/icon.png",
    "owner": "salah_rim"
  }
}