{
  "expo": {
    "name": "Dukan ERP",
    "slug": "dukan-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dukanerp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mr.tsxmr.dukanerp"
    },
    "android": {
      "package": "mr.tsxmr.dukanerp",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4f46e5"
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Dukan ERP uses the camera to scan IMEIs, serial numbers and barcodes so you do not have to type them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dukan ERP opens your photos only when you choose a receipt picture for an expense.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "834d8b25-2737-46e8-b911-3eac6d85c2fb"
      }
    },
    "locales": {
      "fr": "./locales/fr.json",
      "ar": "./locales/ar.json"
    }
  }
}
